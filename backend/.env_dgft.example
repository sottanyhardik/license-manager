# DGFT scrip-ownership lookup: template (OD-06).
# Copy to backend/.env_dgft (untracked, ignored) or set these in the process
# environment on the server. Process environment wins (load_dotenv override=False).
# The app works when this file is absent. Ownership lookups then return
# "DGFT credentials not configured" until the values below are provided.

# --- Non-secret configuration (public DGFT endpoint; same as the settings default)
DGFT_OWNERSHIP_URL=https://www.dgft.gov.in/CP/webHP

# --- Company identifiers (business-confidential, not credentials; not rotatable)
DGFT_SCRIP_NUMBER=<scrip number>
DGFT_SCRIP_ISSUE_DATE=<dd/mm/yyyy>
DGFT_IEC_NUMBER=<10-digit IEC>
# Required by the ownership lookup together with the session values below.
DGFT_APP_ID=<DGFT application id>

# --- SECRETS: short-lived DGFT browser-session cookies. Never commit them.
# Copy them from an authenticated DGFT browser session, and refresh them when a
# lookup is rejected.
DGFT_SESSION_ID=
DGFT_CSRF_TOKEN=
DGFT_AWSALB=
