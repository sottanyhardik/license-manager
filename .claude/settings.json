{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash list:*)",
      "Bash(git stash show:*)",
      "Bash(git worktree:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(python3 .claude/index/build_index.py:*)",
      "Bash(python3 .claude/hooks/test_guard_bash.py:*)",
      "Bash(python3 .claude/hooks/test_hooks.py:*)",
      "Bash(sh scripts/dev/quality-gate.sh:*)",
      "Bash(scripts/dev/quality-gate.sh:*)",
      "Bash(sh scripts/dev/doctor.sh:*)",
      "Bash(scripts/dev/doctor.sh:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python manage.py check:*)",
      "Bash(python manage.py showmigrations:*)",
      "Bash(python runtests.py:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm ci:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx playwright test:*)",
      "mcp__pycharm__get_file_problems",
      "mcp__pycharm__get_project_modules",
      "mcp__pycharm__get_project_dependencies",
      "mcp__pycharm__get_run_configurations",
      "mcp__pycharm__git_status",
      "mcp__pycharm__get_all_open_file_paths",
      "mcp__pycharm__search_symbol",
      "mcp__pycharm__get_symbol_info",
      "mcp__pycharm__search_text",
      "mcp__pycharm__search_regex",
      "mcp__pycharm__lint_files",
      "Bash(python manage.py makemigrations:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(cat:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(which:*)",
      "Bash(npm run:*)",
      "Bash(npm ls:*)",
      "Bash(python -m py_compile:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(git -C:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3 manage.py check:*)",
      "Bash(python3 manage.py makemigrations:*)",
      "Bash(python3 manage.py showmigrations:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/python manage.py check:*)",
      "Bash(.venv/bin/python manage.py makemigrations:*)",
      "Bash(.venv/bin/python manage.py showmigrations:*)",
      "Bash(backend/.venv/bin/python -m pytest:*)",
      "Bash(backend/.venv/bin/python manage.py check:*)",
      "Bash(backend/.venv/bin/python manage.py makemigrations:*)",
      "Bash(backend/.venv/bin/python manage.py showmigrations:*)",
      "Bash(../.venv/bin/python -m pytest:*)",
      "Bash(../.venv/bin/python manage.py check:*)",
      "Bash(../.venv/bin/python manage.py makemigrations:*)",
      "Bash(../.venv/bin/python manage.py showmigrations:*)",
      "Bash(master-data-service/.venv/bin/python -m pytest:*)",
      "Bash(master-data-service/.venv/bin/python manage.py check:*)",
      "Bash(master-data-service/.venv/bin/python manage.py makemigrations:*)",
      "Bash(master-data-service/.venv/bin/python manage.py showmigrations:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git checkout --:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch --delete:*)",
      "Bash(git worktree remove --force:*)",
      "Bash(git worktree remove -f:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh release:*)",
      "Bash(gh api:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm publish:*)",
      "Bash(brew install:*)",
      "Bash(docker:*)",
      "Bash(psql:*)",
      "Bash(dropdb:*)",
      "Bash(createdb:*)",
      "Bash(pg_restore:*)",
      "Bash(redis-cli:*)",
      "Bash(python manage.py migrate:*)",
      "Bash(python manage.py loaddata:*)",
      "Bash(python manage.py shell:*)",
      "Bash(python manage.py dbshell:*)",
      "Bash(rm:*)",
      "mcp__pycharm__execute_sql_query",
      "mcp__pycharm__execute_cross_db_query",
      "mcp__pycharm__import_data",
      "mcp__pycharm__execute_run_configuration"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git filter-branch:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(python manage.py flush:*)",
      "Bash(python manage.py reset_db:*)",
      "Read(./.env)",
      "Read(./backend/.env)",
      "Read(./backend/.env_dgft)",
      "Read(./frontend/.env.production)",
      "Read(./master-data-service/.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env_dgft)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)"
    ]
  },
  "env": {
    "ECC_HOOK_PROFILE": "minimal",
    "BASH_DEFAULT_TIMEOUT_MS": "300000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_commit_check.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/index/hook_postedit.sh\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_validate.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/index/hook_session.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_verify_reminder.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_end.sh\""
          }
        ]
      }
    ]
  }
}
