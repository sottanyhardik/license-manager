# Template for the git-ignored backend/.env (auto-loaded by lmanagement/settings.py).
# Generate the real file with:  scripts/dev/init-local-env.sh
# Local development values only. DGFT session values go in backend/.env_dgft.
DJANGO_ENVIRONMENT=development
DEBUG=true
DJANGO_SECRET_KEY=change-me-local-dev-only
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=lmanagement
DB_USER=lmanagement
DB_PASS=change-me-local-dev-only
DB_HOST=127.0.0.1
DB_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SYNC_ENABLED=False
MDS_ENABLED=False
