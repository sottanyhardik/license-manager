# Deployment target configuration template.
# Copy outside the repository or inject through the deployment secret manager:
#   set -a; source /secure/path/license-manager-staging.env; set +a
#
# This file contains names and placeholders only. Never store it with real values.

# Explicit immutable release and target identity are command-line arguments:
# scripts/deployment/auto-deploy.sh --environment staging --release-sha <40-char-sha>
export DEPLOY_TARGET_HOST='staging-hostname.example'
export DEPLOY_TARGET_USER='deployer'
export DEPLOY_REMOTE_ROOT='/srv/license-manager'
# A pinned known-hosts file managed by the deployment environment.
export DEPLOY_KNOWN_HOSTS_FILE='/secure/path/staging-known_hosts'
# Pre-provisioned remote executable: creates and verifies a database backup.
export DEPLOY_BACKUP_COMMAND='/usr/local/bin/backup-license-manager'
export DEPLOY_WEB_SERVICE='license-manager-web'
export DEPLOY_WORKER_SERVICE='license-manager-worker'
export DEPLOY_BEAT_SERVICE='license-manager-beat'
export DEPLOY_HEALTH_URL='https://staging.example.invalid/api/health/'

# Required for non-dry-run execution. Inject real values only through the secret manager.
export DJANGO_SECRET_KEY='CHANGE_ME'
export DATABASE_URL='CHANGE_ME'
export REDIS_URL='CHANGE_ME'
export CELERY_BROKER_URL='CHANGE_ME'
export CELERY_RESULT_BACKEND='CHANGE_ME'
export ALLOWED_HOSTS='staging.example.invalid'
export CSRF_TRUSTED_ORIGINS='https://staging.example.invalid'
