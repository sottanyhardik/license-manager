# OD-06: the DB password is NEVER written in this file. Export it first:
#   export PGPASSWORD='<database password from the server secret store>'
# pg_dump/dropdb/createdb/pg_restore read PGPASSWORD from the environment.
: "${PGPASSWORD:?PGPASSWORD must be set in the environment (see header of this file)}"

# Dump database from remote server to a compressed file
pg_dump -U lmanagement -h localhost -p 5432 -F c -b -v -f lmanagement.backup lmanagement

# Copy backup from remote to local
scp django@167.71.233.211:/home/django/lmanagement.backup .

# Drop and recreate DB locally
dropdb -U lmanagement -h localhost -p 5432 --if-exists lmanagement
createdb -U lmanagement -h localhost -p 5432 -O lmanagement lmanagement

# Restore locally
pg_restore -U lmanagement -h localhost -p 5432 -d lmanagement -v lmanagement.backup