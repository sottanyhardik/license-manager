# Template for the git-ignored root .env.local (docker compose for local dev).
# Generate the real file with:  scripts/dev/init-local-env.sh
# NOTE: the root .env file is tracked in git — never put credentials in it.
COMPOSE_PROJECT_NAME=license-manager
LM_PG_PORT=5432
LM_REDIS_PORT=6379
LM_DB_NAME=lmanagement
LM_DB_USER=lmanagement
LM_DB_PASSWORD=change-me-local-dev-only
MDS_DB_NAME=master_data
MDS_DB_USER=master_data
MDS_DB_PASSWORD=change-me-local-dev-only
